{
  "name": "LLM memory and guardrails demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Memory and guardrails",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "GRADIO_ANALYTICS_ENABLED": "False",
    "PYTHONUNBUFFERED": "1"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "postStartCommand": "bash -c 'if ! pgrep -f \"^python app.py$\" >/dev/null; then nohup python app.py > app.log 2>&1 < /dev/null & fi'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {"python.defaultInterpreterPath": "/usr/local/bin/python"}
    }
  }
}
